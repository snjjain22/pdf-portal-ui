# Copy these into Railway → Service → Variables

# OpenRouter (LLM for Stage 2 & 3)
OPENROUTER_API_KEY=

# DeepSeek (LLM fallback)
DEEPSEEK_API_KEY=

# AWS S3 (Stage 4 image upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=nextlevelproducts
AWS_REGION=ap-south-1

# HuggingFace (Stage 5 — calls Satyam's Space API)
HF_API_KEY=

# Repo root inside Docker container (already set in Dockerfile)
REPO_ROOT=/app
